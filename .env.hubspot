# Build para HubSpot (npm run build:hubspot): un solo archivo, rutas con #, datos en Supabase.
# La URL y la anon key de Supabase NO van aquí: se escriben en el bloque AU_CONFIG al inicio
# de la plantilla generada (dist-hubspot/alignment-unblock-hubspot.html).
VITE_ROUTER=hash
VITE_STORAGE=supabase
VITE_NO_DEMO=true
