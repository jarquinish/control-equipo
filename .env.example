# Alignment & Unblock — variables de entorno (se leen al compilar con `npm run build`).
# Nunca incluyas secretos en este archivo. La "anon key" de Supabase es pública por diseño
# (la seguridad la aplica la RLS del servidor), pero no la subas al repositorio: configúrala
# en Netlify/Vercel o en un archivo .env.local (ignorado por git).

# Subdirectorio donde se publicará la app (por defecto "/").
BASE_PATH=/

# Almacenamiento: "indexeddb" (local, por defecto) · "supabase" (compartido, multiusuario) · "rest" (API propia)
VITE_STORAGE=indexeddb

# ── Supabase (cuando VITE_STORAGE=supabase) ──
# Supabase → Project Settings → API → Project URL y anon public key
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
# "true" muestra el botón "Entrar con cuenta Microsoft" (requiere configurar el proveedor Azure en Supabase)
VITE_SUPABASE_MICROSOFT=false

# ── API REST propia (cuando VITE_STORAGE=rest) ──
VITE_API_URL=http://localhost:3000/api
