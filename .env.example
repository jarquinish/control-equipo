# Alignment & Unblock — variables de entorno (opcionales)
# Nunca incluyas secretos en este archivo.

# Subdirectorio donde se publicará la app (por defecto "/").
# Ejemplo: BASE_PATH=/alignment/
BASE_PATH=/

# Modo de almacenamiento: "indexeddb" (por defecto, local en el navegador)
# o "rest" (requiere un backend que implemente /api/*; ver README → Backend).
VITE_STORAGE=indexeddb

# URL base de la API cuando VITE_STORAGE=rest.
VITE_API_URL=http://localhost:3000/api
