{
  "name": "alignment-unblock",
  "private": true,
  "version": "1.0.0",
  "description": "Alignment & Unblock · Sistema operativo semanal de alineación, prioridades y desbloqueo — Dirección de Posicionamiento SOC",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc -b --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "test:supabase": "vitest run --config vitest.supabase.config.ts",
    "test:supabase:sql": "bash supabase/tests/run.sh",
    "test:e2e:supabase": "playwright test --config playwright.supabase.config.ts",
    "supabase:local": "node supabase/tests/stack.mjs",
    "build:single": "tsc -b && vite build --mode single --outDir dist-single"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  }
}
