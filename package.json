{
  "name": "alignment-unblock",
  "private": true,
  "version": "1.0.0",
  "description": "Alignment & Unblock · Sistema operativo semanal de alineación, prioridades y desbloqueo — Dirección de Posicionamiento SOC",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
